# Groq API Keys (Supports automatic dual-key fallback on rate limit/quota error)
GROQ_API_KEY_1=gsk_your_primary_key_here
GROQ_API_KEY_2=gsk_your_backup_key_here

# Groq Vision Model (Active vision model: qwen/qwen3.8-27b)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Network & Timeout Configuration
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=10
GROQ_REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES_PER_KEY=2
RETRY_BACKOFF_FACTOR=1.5

# Server Configuration
PORT=8000
HOST=0.0.0.0
